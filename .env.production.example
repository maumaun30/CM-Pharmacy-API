# Copy to .env on the production server and fill in real values.
# .env is gitignored — never commit real secrets.

# ── Postgres container ───────────────────────────────────────────────────────
POSTGRES_USER=cmpharmacy
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=cm_pharmacy

# ── API ──────────────────────────────────────────────────────────────────────
# Long random string. Generate one with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_long_random_secret
JWT_EXPIRES_IN=7d

# Allowed browser origin(s) for CORS (the web admin URL). Comma-separated list.
# For local admin testing you can point this at http://localhost:3000.
CLIENT_URL=https://maunpharmacy.com,https://www.maunpharmacy.com

# ── Google sign-in ───────────────────────────────────────────────────────────
# Comma-separated OAuth client ids allowed in a Google ID token's `aud` claim.
# Include the Web client id (used by the web app and Expo webClientId) plus any
# iOS client id. Required for /auth/google[/link] to verify tokens.
GOOGLE_CLIENT_IDS=901288439348-oo5hkmnfpkn0un1d535un9mktcvn1a26.apps.googleusercontent.com
