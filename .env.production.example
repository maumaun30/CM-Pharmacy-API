# Copy to .env on the production server and fill in real values.
# .env is gitignored — never commit real secrets.

# ── Postgres container ───────────────────────────────────────────────────────
POSTGRES_USER=cmpharmacy
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=cm_pharmacy

# ── API ──────────────────────────────────────────────────────────────────────
# Long random string. Generate one with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_long_random_secret
JWT_EXPIRES_IN=7d

# Allowed browser origin for CORS (the web admin URL). Update once the UI is
# deployed. For local admin testing you can point this at http://localhost:3000.
CLIENT_URL=https://cm-admin.devmau.site
