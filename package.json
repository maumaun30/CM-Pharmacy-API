{
  "name": "pharmacy-pos-api",
  "version": "1.0.0",
  "description": "REST API for a pharmacy POS system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:bootstrap": "bash db/bootstrap.sh",
    "db:reset": "docker compose down -v && docker compose up -d && bash db/bootstrap.sh",
    "db:pull": "drizzle-kit pull"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "dotenv": "^16.0.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.22.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "nodemon": "^2.0.22"
  }
}
