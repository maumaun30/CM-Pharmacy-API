# Caddy reverse proxy with automatic HTTPS (Let's Encrypt).
# Caddy obtains + auto-renews a free TLS certificate for this hostname as long as
# the domain's DNS points at this server and ports 80/443 are reachable.
{
	email admin@devmau.site
}

# Both hostnames route to the same API container. cm-api.devmau.site is kept
# during the maunpharmacy.com migration; remove it once all clients cut over.
cm-api.devmau.site, api.maunpharmacy.com {
	# Proxy all traffic (including Socket.IO WebSocket upgrades) to the API
	# container on the internal Docker network. Caddy handles WS transparently.
	reverse_proxy api:5000
}
