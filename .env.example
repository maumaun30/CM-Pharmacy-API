# development, test, production
NODE_ENV=development
CLIENT_URL=http://localhost:3000
PORT=5000

# Postgres connection (Drizzle). Local dev uses the docker-compose DB on 5544;
# in production point this at AWS RDS.
DATABASE_URL=postgres://cmpharmacy:cmpharmacy@localhost:5544/cm_pharmacy
# Set DB_SSL=true when connecting to a managed Postgres (RDS) that requires SSL.
# DB_SSL=true
# DB_POOL_MAX=10

# Auth
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d

# Google sign-in / linking. Comma-separated allow-list of OAuth client ids that
# may appear in a Google ID token's `aud` claim. Include the Web client id (used
# by the web app AND as Expo's webClientId) plus any iOS/Android client ids.
GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com
